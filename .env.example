# PostgreSQL gerenciado (Neon, Supabase, Vercel Postgres ou equivalente)
DATABASE_URL=postgres://usuario:senha@servidor:5432/pet_identification?sslmode=require

# Gere um valor aleatorio forte (minimo recomendado: 32 caracteres)
SESSION_SECRET=troque-por-um-segredo-aleatorio

