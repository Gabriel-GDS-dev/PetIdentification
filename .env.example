# PostgreSQL
# Local padrao usado pelos scripts deste projeto:
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/pet_identification

# Render:
# Use a Internal Database URL do Render quando o Web Service e o Postgres estiverem na mesma regiao.
# Se usar a External Database URL, deixe sslmode=require no final.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/pet_identification?sslmode=require

# Gere um valor aleatorio forte (minimo recomendado: 32 caracteres)
SESSION_SECRET=troque-por-um-segredo-aleatorio

# Analytics privado (nao compartilhe estes valores)
ANALYTICS_ADMIN_TOKEN=troque-por-um-token-aleatorio-com-32-caracteres
ADMIN_EMAIL=seuemail@gmail.com

# Opcional: endpoints alternativos para consultas de veterinarias
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
